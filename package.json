{
	"name": "ng-hub-ui-paginable",
	"version": "22.27.0",
	"description": "Highly customizable Angular table and list components with pagination, sorting and filtering support. Built with Angular 19+ and Signal-based architecture.",
	"peerDependencies": {
		"@angular/common": ">=21.0.0",
		"@angular/core": ">=21.0.0",
		"@angular/forms": ">=21.0.0",
		"ng-hub-ui-ds": ">=22.0.0",
		"ng-hub-ui-utils": ">=22.8.0"
	},
	"peerDependenciesMeta": {
		"ng-hub-ui-ds": {
			"optional": true
		}
	},
	"dependencies": {
		"tslib": "^2.3.0"
	},
	"sideEffects": false,
	"exports": {
		"./styles": "./styles/index.scss",
		"./styles/index.scss": "./styles/index.scss",
		"./styles/mixins/table-theme": "./styles/mixins/_table-theme.scss",
		"./styles/mixins/list-theme": "./styles/mixins/_list-theme.scss",
		"./styles/mixins/table-variant": "./styles/mixins/_table-variant.scss"
	},
	"scripts": {
		"build": "ng build paginable",
		"build:prod": "ng build paginable --configuration production",
		"test": "ng test paginable",
		"test:watch": "ng test paginable --watch",
		"test:coverage": "ng test paginable --code-coverage",
		"lint": "ng lint paginable",
		"pack": "cd ../../dist/paginable && npm pack",
		"publish:npm": "cd ../../dist/paginable && npm publish"
	},
	"files": [
		"**/*",
		"!**/*.spec.ts",
		"!**/*.spec.js",
		"!**/*.test.ts",
		"!**/*.test.js"
	],
	"keywords": [
		"angular",
		"table",
		"list",
		"pagination",
		"sortable",
		"filterable",
		"filter",
		"sorter",
		"expandable",
		"selectable",
		"custom",
		"template",
		"paginable",
		"translatable",
		"responsive",
		"data-grid",
		"data-table",
		"component",
		"reusable",
		"open-source",
		"typescript",
		"standalone",
		"signals",
		"reactive-forms",
		"ui-library",
		"ng-hub-ui"
	],
	"author": "Carlos Morcillo Fern\u00e1ndez <carlos.morcillo@me.com> (https://www.carlosmorcillo.com)",
	"maintainers": [
		{
			"name": "Carlos Morcillo Fern\u00e1ndez",
			"email": "carlos.morcillo@me.com",
			"url": "https://www.carlosmorcillo.com"
		}
	],
	"homepage": "https://hubui.dev/en/paginable/overview/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hub-env/ng-hub-ui-paginable.git"
	},
	"bugs": {
		"url": "https://github.com/hub-env/hub-ui/issues",
		"email": "carlos.morcillo@me.com"
	},
	"funding": {
		"type": "buymeacoffee",
		"url": "https://buymeacoffee.com/carlosmorcillo"
	},
	"license": "MIT",
	"engines": {
		"node": ">=18.13.0",
		"npm": ">=9.0.0"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"ng-add": {
		"save": "dependencies"
	},
	"contributors": [
		"Carlos Morcillo Fern\u00e1ndez <carlos.morcillo@me.com>"
	]
}
